# Quarto
_book/
# Chunk output directories Quarto writes beside each source file.
# Regenerable from the sources and the freeze cache, so they are
# ignored for the same reason _book/ is.
**/*_files/
.quarto/
/.quarto/
**/*.quarto_ipynb
# LaTeX intermediates from a PDF render.
*.aux
*.toc
*.log
*.out
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.html
*.pdf
.netlify

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
inst/doc

# renv
renv/library/
renv/staging/

# Raw data (Decision D7: generator committed, CSV gitignored). The
# whole directory is ignored, not one filename, so that a second
# extract under any name cannot be committed by accident. Only a
# README describing the directory may be tracked.
analysis/data/raw_data/*
!analysis/data/raw_data/README.md

# zzcollab
.make/
.zzcollab.log

# OS / editors
.DS_Store
node_modules/
